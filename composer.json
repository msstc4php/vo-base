{
    "name": "msstc4php/value-objects",
    "description": "Immutable value objects for PHP 8.4+, with no framework dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "value-object",
        "immutable",
        "ddd"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "brick/math": "^0.12 || ^0.13 || ^0.14",
        "brick/money": "^0.10",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.29",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "symfony/intl": "^7.2"
    },
    "suggest": {
        "brick/math": "Enables arithmetic on Decimal and Percentage (add, divide, round, ...).",
        "brick/money": "Pairs with CurrencyCode for full money handling (arithmetic, rounding).",
        "msstc4php/vo-base-doctrine-bridge": "Doctrine ORM and MongoDB ODM field types and money embeddables for these value objects.",
        "msstc4symfony/vo-base-bridge": "Symfony Validator constraints and a bundle that wires everything up."
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": false
        }
    }
}
