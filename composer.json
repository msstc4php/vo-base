{
    "name": "msstc4php/vo-base",
    "description": "Immutable value objects for PHP 8.4+, with no framework dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "value-object",
        "immutable",
        "ddd"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.76",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": ">=11.0",
        "rector/rector": "^2.1",
        "roave/security-advisories": "dev-latest"
    },
    "conflict": {
        "brick/math": "<0.15",
        "brick/money": "<0.15"
    },
    "suggest": {
        "brick/math": "Enables arithmetic on Decimal and Percentage (add, divide, round, ...).",
        "brick/money": "Pairs with CurrencyCode for full money handling (arithmetic, rounding).",
        "msstc4php/vo-base-doctrine": "Doctrine ORM and MongoDB ODM field types and money embeddables for these value objects.",
        "msstc4php/vo-base-bundle": "Symfony Validator constraints and a bundle that wires everything up."
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "extra": {
        "bundle-standard": {
            "kind": "library",
            "runtime": "php84"
        }
    }
}
