{
    "name": "msstc4php/value-objects",
    "description": "Immutable value objects for PHP 8.4+ with optional Doctrine ORM/ODM and Symfony Validator bridges.",
    "type": "library",
    "license": "MIT",
    "keywords": ["value-object", "immutable", "doctrine", "symfony", "validator", "ddd"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "brick/money": "^0.10",
        "deptrac/deptrac": "^3.0",
        "doctrine/dbal": "^4.4",
        "doctrine/mongodb-odm": "^2.9",
        "doctrine/orm": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.29",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-beberlei-assert": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "symfony/intl": "^7.2",
        "symfony/validator": "^7.2"
    },
    "suggest": {
        "doctrine/dbal": "To persist scalar value objects as Doctrine ORM column types.",
        "doctrine/orm": "To map value objects and the GeoCoordinates embeddable.",
        "doctrine/mongodb-odm": "To persist value objects with Doctrine MongoDB ODM.",
        "symfony/validator": "To validate raw input against value object rules via constraints.",
        "brick/money": "Pairs with CurrencyCode for full money handling (arithmetic, rounding)."
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": false
        }
    }
}
